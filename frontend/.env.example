# ZeroDay-Guard AI — frontend environment
# Copy to frontend/.env.local and adjust.

# Base URL of the FastAPI backend.
# Use the explicit IPv4 loopback locally: browsers resolve "localhost" to ::1
# first on some systems, while uvicorn usually binds 127.0.0.1 only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
