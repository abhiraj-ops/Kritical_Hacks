# `/api` works with `npm run dev` when the backend server is running.
VITE_API_BASE_URL=/api
VITE_ENVIRONMENT=development

# TinyFish — get a key at https://agent.tinyfish.ai/api-keys
# NEVER commit a real key. Copy this to `.env.local` (gitignored) and set it there:
#   VITE_TINYFISH_API_KEY=sk-tinyfish-...
VITE_TINYFISH_API_KEY=

# Optional backend route used by the assistant. No browser-side secret is required.
VITE_ASSISTANT_ENDPOINT=
