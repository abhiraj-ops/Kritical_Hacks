# ─────────────────────────────────────────────────────────────
# EcoPulse AI — environment variables
#
# Copy to `.env` for `netlify dev`, or set these in the Netlify
# dashboard under Site settings → Environment variables.
#
# NEVER commit real values. `.env` and `.env.local` are gitignored.
# ─────────────────────────────────────────────────────────────

# Required for the "Run TinyFish Web Agent" button.
# Get a key at https://agent.tinyfish.ai/api-keys
# Without it the UI shows "Key needed" — it never fakes a result.
TINYFISH_API_KEY=

# Optional — air quality (PM2.5 / PM10). Without it, OpenAQ is skipped.
# https://explore.openaq.org/register
OPENAQ_API_KEY=

# Optional — NASA FIRMS active fire hotspots. Without it, FIRMS is skipped.
# https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# Optional — how many days of FIRMS data to request (default 1).
NASA_FIRMS_DAY=1