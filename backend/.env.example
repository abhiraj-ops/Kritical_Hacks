# ZeroDay-Guard AI — environment template
# Copy to backend/.env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# TinyFish (mandatory for the live agent)
# Get a key: https://agent.tinyfish.ai/api-keys
# Set to "demo" to run with simulated intelligence and no network calls.
TINYFISH_API_KEY=demo

# ---------------------------------------------------------------------------
# Reasoning provider (optional — there is a fallback chain)
#   openai  ->  anthropic  ->  tinyfish-research  ->  deterministic template
# Leave both blank to use TinyFish Research (your key already enables it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# ML engine
# Set ENABLE_CODEBERT=false to skip the (large) model download entirely.
ENABLE_CODEBERT=true
CODEBERT_MODEL=microsoft/codebert-base
TORCH_THREADS=4

# ---------------------------------------------------------------------------
# Service
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
